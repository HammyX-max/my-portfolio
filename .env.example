# Copy to .env for local Netlify CLI use, or add these in Netlify Environment Variables.
# Never use real values in frontend HTML or commit a populated .env file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
SUPABASE_ADMIN_EMAIL=YOUR_SUPABASE_AUTH_EMAIL
SESSION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_OPENSSL_RAND_HEX_32
ADMIN_USER_IDS=YOUR_SUPABASE_AUTH_USER_UUID
SITE_ORIGIN=https://YOUR_NETLIFY_SITE.netlify.app
